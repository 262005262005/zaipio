# =============================================
# ZAIPIO — Environment Variables Template
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# =============================================

# ---- App ----
NODE_ENV=development
APP_NAME=ZAIPIO
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/zaipio_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=zaipio_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here

# ---- Redis ----
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Auth (JWT) ----
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# ---- Encryption (for platform API keys) ----
ENCRYPTION_KEY=your_32_char_encryption_key_here

# ---- Razorpay (Billing) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ---- Cloudflare R2 (File Storage) ----
R2_ACCOUNT_ID=your_cf_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=zaipio-labels
R2_PUBLIC_URL=https://your-bucket.r2.dev

# ---- Amazon SP-API ----
AMAZON_CLIENT_ID=amzn1.application-oa2-client.xxxx
AMAZON_CLIENT_SECRET=your_amazon_client_secret
AMAZON_REFRESH_TOKEN=Atzr|xxxx

# ---- Flipkart API ----
FLIPKART_CLIENT_ID=your_flipkart_client_id
FLIPKART_CLIENT_SECRET=your_flipkart_client_secret

# ---- Meesho API ----
MEESHO_API_KEY=your_meesho_api_key

# ---- Shopify ----
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
SHOPIFY_SCOPES=read_orders,write_inventory,read_products,read_fulfillments

# ---- Notifications ----
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ---- Email ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@zaipio.com

# ---- Shiprocket (Logistics) ----
SHIPROCKET_EMAIL=your_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password

# ---- Label Job Schedule ----
LABEL_AUTO_DOWNLOAD_CRON=0 12 * * *

# ---- Feature Flags ----
FEATURE_PROFIT_CALCULATOR=true
FEATURE_WHATSAPP_ALERTS=false
FEATURE_AD_TRACKER=false
