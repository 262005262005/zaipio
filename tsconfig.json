{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@zaipio/shared": ["./packages/shared/src"],
      "@zaipio/ui": ["./packages/ui/src"],
      "@zaipio/database": ["./packages/database/src"],
      "@zaipio/config": ["./packages/config/src"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "build"]
}
